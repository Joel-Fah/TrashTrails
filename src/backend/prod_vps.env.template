# ============================================================================
# DJANGO PRODUCTION ENVIRONMENT VARIABLES
# VPS Deployment Template (Lightsail, EC2, DigitalOcean, etc.)
# ============================================================================

# Instructions:
# 1. Copy this file to prod.env
# 2. Replace all placeholder values with your actual values
# 3. Never commit prod.env to version control (add to .gitignore)

# ============================================================================
# CORE DJANGO SETTINGS
# ============================================================================

# Generate a new secret key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-generate-a-new-one

# Should always be False in production
DEBUG=False

# Environment name
DJANGO_SETTINGS_MODULE=your_project_name.settings.production

# ============================================================================
# ALLOWED HOSTS & DOMAINS
# ============================================================================

# Space-separated list of allowed hosts
# Include: domain name, www subdomain, server IP
ALLOWED_HOSTS=yourdomain.com www.yourdomain.com 123.456.789.0

# Main site URL (use https:// in production)
SITE_URL=https://yourdomain.com

# Space-separated list of trusted origins for CSRF
# Include all domains/subdomains users will access the site from
CSRF_TRUSTED_ORIGINS=https://yourdomain.com https://www.yourdomain.com

# ============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# ============================================================================

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# SSL/HTTPS SECURITY SETTINGS
# ============================================================================

# Enable these AFTER SSL certificate is installed
# Set to True once you have HTTPS configured
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Enable HSTS (HTTP Strict Transport Security) for better security
# Only enable after confirming HTTPS works correctly
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

# Email backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP settings (example: Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default from email
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
SERVER_EMAIL=server@yourdomain.com

# Admin email for error notifications
ADMIN_EMAIL=admin@yourdomain.com
